#!/usr/bin/env python3
"""
Export generated by /cdp:export
Dependency: pip install python-docx
"""

import os
import re
import sys

try:
    from docx import Document
    from docx.shared import Pt, Cm, RGBColor, Inches
    from docx.enum.text import WD_ALIGN_PARAGRAPH
    from docx.oxml.ns import qn
    from docx.oxml import OxmlElement
except ImportError:
    print("python-docx not found. Run: pip install python-docx")
    sys.exit(1)

# ── Configuration ─────────────────────────────────────────────────────

PRIMARY_COLOR  = "{{PRIMARY_COLOR}}"
DOCUMENT_NAME  = "{{DOCUMENT_NAME}}"
PROJECT_NAME   = "{{PROJECT_NAME}}"
VERSION        = "{{VERSION}}"
CREATION_DATE  = "{{CREATION_DATE}}"
LAST_CYCLE     = "{{LAST_CYCLE}}"
LOGO_PATH      = {{LOGO_PATH}}
OUTPUT_PATH    = "{{OUTPUT_PATH}}"

SECTIONS = [
    ("01", "Brand Identity",               """{{SECTION_1}}"""),
    ("02", "Target Audience",              """{{SECTION_2}}"""),
    ("03", "Campaign / Project Objective", """{{SECTION_3}}"""),
    ("04", "Value Proposition",            """{{SECTION_4}}"""),
    ("05", "Message Hierarchy",            """{{SECTION_5}}"""),
    ("06", "Tone of Voice",                """{{SECTION_6}}"""),
    ("07", "Channels & Touchpoints",       """{{SECTION_7}}"""),
    ("08", "Competitive Positioning",      """{{SECTION_8}}"""),
    ("09", "Constraints",                  """{{SECTION_9}}"""),
    ("10", "Declared Limitations",         """{{SECTION_10}}"""),
    ("11", "References & Source Materials", """{{SECTION_11}}"""),
]

# ── Utility ───────────────────────────────────────────────────────────

def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def add_left_border(para, color_hex, sz=18, space=12):
    pPr = para._p.get_or_add_pPr()
    pBdr = OxmlElement("w:pBdr")
    left = OxmlElement("w:left")
    left.set(qn("w:val"),   "single")
    left.set(qn("w:sz"),    str(sz))
    left.set(qn("w:space"), str(space))
    left.set(qn("w:color"), color_hex.lstrip("#"))
    pBdr.append(left)
    pPr.append(pBdr)

def add_bottom_border(para, color_hex, sz=8):
    pPr = para._p.get_or_add_pPr()
    pBdr = OxmlElement("w:pBdr")
    bot = OxmlElement("w:bottom")
    bot.set(qn("w:val"),   "single")
    bot.set(qn("w:sz"),    str(sz))
    bot.set(qn("w:space"), "1")
    bot.set(qn("w:color"), color_hex.lstrip("#"))
    pBdr.append(bot)
    pPr.append(pBdr)

def add_top_border(para, color_hex, sz=6):
    pPr = para._p.get_or_add_pPr()
    pBdr = OxmlElement("w:pBdr")
    top = OxmlElement("w:top")
    top.set(qn("w:val"),   "single")
    top.set(qn("w:sz"),    str(sz))
    top.set(qn("w:space"), "1")
    top.set(qn("w:color"), color_hex.lstrip("#"))
    pBdr.append(top)
    pPr.append(pBdr)

def add_inline_fmt(para, text):
    """Handles **bold** and *italic* inline."""
    for part in re.split(r"(\*\*[^*]+\*\*|\*[^*]+\*)", text):
        if not part:
            continue
        if part.startswith("**") and part.endswith("**") and len(part) > 4:
            r = para.add_run(part[2:-2]); r.bold = True
        elif part.startswith("*") and part.endswith("*") and len(part) > 2:
            r = para.add_run(part[1:-1]); r.italic = True
        else:
            para.add_run(part)

def is_table_row(line):
    return "|" in line and line.strip().startswith("|")

def is_separator_row(line):
    return is_table_row(line) and all(c in "|- :" for c in line.strip())

def parse_md_table(lines):
    rows = []
    for line in lines:
        if is_separator_row(line):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        rows.append(cells)
    return rows

def render_table(doc, table_lines, primary_hex):
    rows = parse_md_table(table_lines)
    if not rows:
        return
    ncols = max(len(r) for r in rows)
    tbl = doc.add_table(rows=len(rows), cols=ncols)
    tbl.style = "Table Grid"
    rgb = hex_to_rgb(primary_hex)
    for i, row in enumerate(rows):
        for j in range(ncols):
            cell = tbl.cell(i, j)
            cell.text = ""
            p = cell.paragraphs[0]
            p.paragraph_format.space_before = Pt(3)
            p.paragraph_format.space_after  = Pt(3)
            text = row[j] if j < len(row) else ""
            run = p.add_run(text)
            run.font.size = Pt(9)
            if i == 0:
                run.bold = True
                run.font.color.rgb = RGBColor(255, 255, 255)
                tc   = cell._tc
                tcPr = tc.get_or_add_tcPr()
                shd  = OxmlElement("w:shd")
                shd.set(qn("w:val"),   "clear")
                shd.set(qn("w:color"), "auto")
                shd.set(qn("w:fill"),  primary_hex.lstrip("#"))
                tcPr.append(shd)

def render_section_body(doc, text, primary_hex):
    stripped = text.strip()
    if not stripped or "[TO BE DEFINED]" in stripped:
        p = doc.add_paragraph()
        r = p.add_run("Section not yet defined")
        r.italic = True
        r.font.color.rgb = RGBColor(180, 180, 180)
        p.paragraph_format.space_after = Pt(6)
        return

    lines = stripped.split("\n")
    table_buf  = []
    in_table   = False
    cur_para   = None

    def flush_table():
        nonlocal table_buf, in_table
        if table_buf:
            render_table(doc, table_buf, primary_hex)
            table_buf = []
        in_table = False

    for raw in lines:
        line = raw.rstrip()

        if is_table_row(line):
            if not in_table:
                cur_para = None
                in_table = True
            table_buf.append(line)
            continue

        if in_table:
            flush_table()

        if not line:
            cur_para = None
            continue

        if line.startswith("- ") or line.startswith("* "):
            p = doc.add_paragraph(style="List Bullet")
            add_inline_fmt(p, line[2:])
            p.paragraph_format.space_after = Pt(2)
            cur_para = None
            continue

        if re.match(r"^\d+[.)]\s", line):
            p = doc.add_paragraph(style="List Number")
            content = re.sub(r"^\d+[.)]\s+", "", line)
            add_inline_fmt(p, content)
            p.paragraph_format.space_after = Pt(2)
            cur_para = None
            continue

        if cur_para is None:
            cur_para = doc.add_paragraph()
            cur_para.paragraph_format.space_after = Pt(6)
        else:
            cur_para.add_run(" ")
        add_inline_fmt(cur_para, line)

    if in_table:
        flush_table()

# ── Document generation ───────────────────────────────────────────────

def main():
    primary_rgb = hex_to_rgb(PRIMARY_COLOR)

    doc = Document()

    # A4 page
    for sec in doc.sections:
        sec.page_width   = Cm(21)
        sec.page_height  = Cm(29.7)
        sec.left_margin  = Cm(2.5)
        sec.right_margin = Cm(2.5)
        sec.top_margin   = Cm(2)
        sec.bottom_margin = Cm(2)

    # Base style
    normal = doc.styles["Normal"]
    normal.font.name = "Helvetica Neue"
    normal.font.size = Pt(10.5)
    normal.paragraph_format.line_spacing = Pt(16)

    # ── Logo ──
    if LOGO_PATH:
        try:
            logo_p = doc.add_paragraph()
            logo_p.paragraph_format.space_after = Pt(6)
            logo_p.add_run().add_picture(LOGO_PATH, height=Cm(1.4))
        except Exception as e:
            print(f"Warning: logo not loaded ({e})")

    # ── Project metadata ──
    meta = doc.add_paragraph()
    if PROJECT_NAME:
        r = meta.add_run(PROJECT_NAME.upper() + "   ")
        r.font.size  = Pt(7.5)
        r.bold       = True
        r.font.color.rgb = RGBColor(*primary_rgb)
    r2 = meta.add_run(f"v{VERSION}  ·  {CREATION_DATE}")
    r2.font.size       = Pt(7.5)
    r2.font.color.rgb  = RGBColor(130, 130, 130)
    meta.paragraph_format.space_after = Pt(2)

    # Separator line
    sep = doc.add_paragraph()
    add_bottom_border(sep, PRIMARY_COLOR, sz=12)
    sep.paragraph_format.space_before = Pt(0)
    sep.paragraph_format.space_after  = Pt(20)

    # ── Document title ──
    title_p = doc.add_paragraph()
    tr = title_p.add_run(DOCUMENT_NAME)
    tr.font.name = "Georgia"
    tr.font.size = Pt(22)
    title_p.paragraph_format.space_after = Pt(2)

    accent = doc.add_paragraph()
    add_bottom_border(accent, PRIMARY_COLOR, sz=20)
    accent.paragraph_format.space_before = Pt(0)
    accent.paragraph_format.space_after  = Pt(32)

    # ── Sections ──
    for num, title, content in SECTIONS:
        h = doc.add_paragraph()
        rn = h.add_run(f"{num}  ")
        rn.font.size       = Pt(7.5)
        rn.bold            = True
        rn.font.color.rgb  = RGBColor(*primary_rgb)
        rt = h.add_run(title)
        rt.font.name = "Georgia"
        rt.font.size = Pt(13)
        add_left_border(h, PRIMARY_COLOR)
        h.paragraph_format.left_indent  = Cm(0.3)
        h.paragraph_format.space_before = Pt(22)
        h.paragraph_format.space_after  = Pt(8)

        render_section_body(doc, content, PRIMARY_COLOR)

    # ── Footer ──
    footer = doc.add_paragraph()
    add_top_border(footer, PRIMARY_COLOR, sz=6)
    footer.paragraph_format.space_before = Pt(28)
    rf = footer.add_run(
        f"v{VERSION}  ·  Created: {CREATION_DATE}  ·  "
        f"Last cycle: {LAST_CYCLE}     Generated by cdp"
    )
    rf.font.size      = Pt(7.5)
    rf.font.color.rgb = RGBColor(150, 150, 150)

    # ── Save ──
    os.makedirs(os.path.dirname(OUTPUT_PATH) or ".", exist_ok=True)
    doc.save(OUTPUT_PATH)
    print(f"✅ File saved: {OUTPUT_PATH}")

if __name__ == "__main__":
    main()
